# WattTime v3 credentials (optional)
WATTTIME_USER=
WATTTIME_PASS=

# Electricity Maps API token (optional - free tier at https://api.electricitymap.org/)
ELECTRICITY_MAPS_TOKEN=

# Grid carbon intensity provider: electricitymaps | watttime
# Falls back to static-fallback values if the API call fails or token is missing
GRID_PROVIDER=electricitymaps

# Mirantis MKE / Prometheus live metrics (optional - falls back to static config values)
# KUBECONFIG_DIR: path to your UCP client bundle directory (contains kube.yml + certs)
# Used by docker-compose to mount the bundle into the backend container
KUBECONFIG_DIR=../ucp-bundle-cliftonreddy

# Which ucp-metrics pod replica to exec into (prefix — auto-discovers current pod name)
PROMETHEUS_POD=ucp-metrics

# Google Analytics 4 — live functional unit counts (optional)
# GA4_PROPERTY_ID: numeric property ID from GA4 Admin → Property Settings
# GOOGLE_APPLICATION_CREDENTIALS: path to service account JSON key file
#   - Download from Google Cloud Console → IAM → Service Accounts → Keys
#   - Grant the service account "Viewer" role on your GA4 property
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=./ga4-service-account.json

# Azure DevOps CI/CD — live pipeline run counts (optional)
# ADO_ORGS: comma-separated collection/org names
# ADO_ORG:  legacy single-org fallback (leave blank if using ADO_ORGS)
# ADO_PAT:  Personal Access Token — full access, or scopes:
#           Build (Read), Release (Read), Project and Team (Read), Agent Pools (Read)
#           Generate at https://dev.azure.com/{org}/_usersSettings/tokens
# ADO_PROJECTS: comma-separated project names (leave blank = auto-discover)
ADO_ORG=
ADO_ORGS=
ADO_PAT=
ADO_PROJECTS=

# --- For running locally without Docker (start-backend.bat uses these) ---
KUBECONFIG=
KUBECTL_PATH=
